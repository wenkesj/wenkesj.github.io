source "https://rubygems.org"

# Plain Jekyll 4.4. Local preview and the GitHub Actions build (see
# .github/workflows/jekyll.yml) both use this exact version, so what
# you see locally is what GitHub Pages will publish.
gem "jekyll", "~> 4.4"
gem "kramdown-parser-gfm"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Required on modern Ruby (dropped from stdlib in Ruby 3.4+).
gem "csv"
gem "webrick"
gem "base64"
